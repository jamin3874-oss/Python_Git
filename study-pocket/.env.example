# Server AI: set both as encrypted production environment variables in Vercel.
# STUDY_APP_ACCESS_TOKEN is a separate, random app access code (32+ characters).
# A login exchanges that code for a 30-day HttpOnly cookie; the API key stays on the server.
# Leave blank here. Never commit real values. Personal API-key mode also remains available.
CODYSSEY_API_KEY=
STUDY_APP_ACCESS_TOKEN=
